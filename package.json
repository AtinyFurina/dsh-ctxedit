{
  "name": "@atinyfurina/dsh-ctxedit",
  "version": "0.5.1",
  "private": true,
  "description": "DeepSeek Harness plugin: per-message context editing for the model-visible history — rewrite a reply (text + reasoning), rewrite/retract the turn's user prompt with Claude-Code-style rewind, or delete a node. Original log content is never modified.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "docs",
    "tools"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "license": "MIT"
}



